# ── Server ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# Origin(s) allowed by CORS, comma-separated.
# 'localhost' and '127.0.0.1' are DIFFERENT origins to the browser, so list both
# for local development — Vite may serve the app on either one.
# In production set this to your real frontend origin, e.g. https://app.example.com
# Never use '*' — the API is called with credentials, which forbids a wildcard.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# ── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/resumeai

# ── Auth ───────────────────────────────────────────────
# Use a long, random string in production. NEVER commit the real value.
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── AI provider (Anthropic / Claude) ───────────────────
# Server-side only — never exposed to the client, never returned by an endpoint.
# Required by every AI feature: Ask AI, Tailor for a job, resume import,
# ATS score, story→resume and the AI Resume Interview.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_MODEL=claude-opus-4-8
